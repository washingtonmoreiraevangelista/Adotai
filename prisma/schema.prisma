// Define o cliente Prisma que será gerado com base no schema
generator Client {
  provider = "prisma-client-js"
}

//Define de onde o Prisma vai se conectar para acessar os dados
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  MENBER
}


model Ongs {
  id            String @id @default(uuid())
  name          String
  phone         String
  email         String @unique
  password_hash String
  address       String
  city          String
  role          Role     @default(MENBER)
  created_At     DateTime @default(now())

  pets          Pets[] 
}

model Pets {
  id           String @id @default(uuid())
  name         String
  description  String
  type         String
  raca         String
  idade        String
  city         String
  size         String
  adopted      Boolean  @default(false)
  created_At    DateTime @default(now())

  ongId        String
  ong          Ongs     @relation(fields: [ongId], references: [id])
}

